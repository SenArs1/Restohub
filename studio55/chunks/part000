/* STUDIO 55 / EDITORIAL EDITION — human-scale restaurant menu
   Visual intent: ink, warm ivory, subdued bronze, restaurant photography.
   Designed mobile-first in spirit; no heavy animation dependencies. */
:root{
 --night:#11171e;--night2:#171f28;--night3:#26303a;
 --cream:#f4e9d9;--soft:#d9c9ba;--muted:#a7aaa8;
 --copper:#e0a27d;--rust:#b36e59;--line:#4a4650;
 --sans:'Avenir Next','Lato','Trebuchet MS',Arial,sans-serif;
 --serif:'Baskerville','Iowan Old Style','Palatino Linotype',Georgia,serif;
}
html{scroll-padding-top:100px}
body{background:radial-gradient(ellipse at 100% 9%,#282026 0,transparent 33%),#11171e;color:var(--cream);font-family:var(--sans);font-size:15px}
.site{overflow:clip}
.wrap{width:min(1240px,calc(100% - 88px));margin-inline:auto}
/* HERO: let the restaurant's own photography and typography lead. */
.hero{min-height:640px;border-bottom:1px solid #8e705e55;background:#141820}
.hero::before{z-index:2;top:auto;bottom:-245px;right:calc(15% - 140px);width:520px;height:520px;border-color:#bd967a24;box-shadow:0 0 0 72px #c5a18009,0 0 0 170px #c5a18006}
.hero::after{background:linear-gradient(90deg,#11171efc 0%,#141820eb 30%,#131920ad 49%,#13181f21 82%),linear-gradient(0deg,#141a22b5 0%,transparent 40%)}
.hero-picture{width:75%;height:100%;object-position:58% 51%;filter:saturate(.95) contrast(1.05) brightness(.9)}
.topline{padding-top:37px;align-items:center}
.mark{gap:8px;color:#f6eee3}
.mark .word{font-family:var(--serif);font-size:30px;letter-spacing:-.055em;font-weight:400}
.mark .digits{font-family:var(--serif);color:var(--copper);font-size:54px;letter-spacing:-.08em}
.header-right{font-weight:600;color:#f0dfcd;font-size:11px;letter-spacing:.16em}
.header-right .pin{color:#f4c29c}
.hero-body{padding-top:126px;padding-bottom:150px}
.hero-eyebrow,.smallcaps{color:#e2b392;letter-spacing:.33em;font-size:11px}
.hero-title{font-family:var(--serif);font-size:clamp(93px,10vw,166px);font-weight:400;letter-spacing:-.068em;line-height:.88;margin:24px 0 21px;text-shadow:0 4px 24px #0003}
.hero-title em{color:#e2a27e;font-style:italic}
.hero-sub{font-size:16px;line-height:1.7;color:#f0e4d8;max-width:400px;letter-spacing:0;font-weight:400}
.hero-line{width:100px;margin:31px 0 20px;background:#dba17f}
.hero-tag{font-size:30px;font-family:var(--serif);font-style:italic;color:#f5d9c0}
.hero-number{font-style:italic;opacity:.1;right:8%;bottom:60px}
.hero-foot{position:absolute;z-index:4;left:0;right:0;bottom:0;display:flex;align-items:center;justify-content:space-between;padding-top:14px;padding-bottom:23px;border-top:1px solid #fff4;color:#f6e2d4;font-size:10px;letter-spacing:.18em;text-transform:uppercase}
.hero-foot a{color:#f1c7a9;display:inline-flex;gap:12px;align-items:center;padding:8px 0}
.hero-foot .foot-arrow{display:inline-block;font-size:19px;line-height:0;font-weight:300}
@media(prefers-reduced-motion:no-preference){.hero-title,.hero-eyebrow,.hero-tag{animation:studioRise .65s cubic-bezier(.22,1,.36,1) both}.hero-eyebrow{animation-delay:.06s}.hero-title{animation-delay:.13s}.hero-tag{animation-delay:.24s}}
@keyframes studioRise{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:translateY(0)}}
/* Compact, truly horizontal, scrollable category navigation */
.nav-shell{top:0;z-index:60;background:#131a21f5;border-bottom:1px solid #83736652;backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px)}
.tabs{gap:27px;padding:0 0;scroll-snap-type:x proximity;scroll-padding-inline:10px;min-height:72px;align-items:center;touch-action:pan-x pan-y}
.tab{position:relative;border:0;border-radius:0;background:none;padding:23px 0 20px;min-height:64px;text-align:center;color:#c2b7ac;font-size:11px;font-weight:600;letter-spacing:.1em;transition:color .18s ease;scroll-snap-align:center}
.tab::after{content:'';position:absolute;bottom:9px;left:0;right:0;height:2px;background:var(--copper);transform:scaleX(0);transform-origin:center;transition:transform .22s cubic-bezier(.22,1,.36,1)}
.tab.active,.tab:hover{border:0;background:none;color:#f7ddc6;font-weight:700}
.tab.active::after{transform:scaleX(1)}
/* Heading hierarchy */
main{padding-bottom:32px}
.headrow{padding:38px 0 2px;gap:22px}
.headrow .intro{color:#c8aa96;font-size:11px;letter-spacing:.22em;font-weight:600}
.search{background:#222831;border:1px solid #68554e;border-radius:4px;min-height:49px;padding:13px 17px;color:#dab397;transition:border-color .16s ease,background-color .16s ease}
.search:focus-within{border-color:#ecb78d;background:#262b34}
.search input{font-size:15px;color:#f7f0e6}
.search input::placeholder{color:#bdada1}
.menu-section{padding-top:58px;padding-bottom:14px;scroll-margin-top:116px}
.section-header{margin-bottom:26px;padding:0 0 20px;border-bottom:1px solid #71605682;align-items:end}
.section-kicker{font-size:10px;letter-spacing:.26em;color:#d8a386;font-weight:700}
.section-header h2{font-family:var(--serif);font-size:clamp(61px,6.5vw,96px);line-height:.94;letter-spacing:-.055em;margin:12px 0 0;color:#f6ecdc}
.section-ornament{font-family:var(--serif);font-size:52px;opacity:.5;color:#bd826c}
/* Editorial dishes: avoid default framed AI tiles */
.dish-grid{grid-template-columns:repeat(2,minmax(0,1fr));column-gap:35px;row-gap:35px}
.dish{display:block;min-height:0;border:0;border-bottom:1px solid #6d625958;border-radius:0;background:transparent;overflow:visible;transition:none}
.dish:hover{border-color:#a084705f}
.dish-media{height:auto;min-height:0;aspect-ratio:1.58;border-radius:3px;background:#2b292a;overflow:hidden}
.dish-media img{height:100%;width:100%;object-fit:cover;object-position:center;transition:transform .5s cubic-bezier(.2,.7,.15,1),filter .3s ease}
.dish:hover .dish-media img{transform:scale(1.025)}
.dish-copy{position:relative;padding:18px 100px 24px 0;min-height:136px}
.dish-copy h3{font-family:var(--serif);font-size:clamp(29px,2.8vw,40px);letter-spacing:-.038em;line-height:1.06;margin:0 0 10px;color:#f9ebd8}
.dish-copy p{font-size:13px;line-height:1.62;color:#c6c1bd;letter-spacing:.002em;margin:0;max-width:43ch}
.dish-bottom{position:absolute;right:0;top:21px;margin:0}
.dish-bottom strong{font-family:var(--serif);font-size:27px;white-space:nowrap;color:#e5ae8e;font-weight:400}
.dish-bottom strong small{font-size:20px}
.no-photo{background:linear-gradient(115deg,#2b333a,#1b242e 63%,#28313a);color:#b79a88}
.no-photo span{font-size:86px;opacity:.55}
.no-photo small{color:#b09b8d;letter-spacing:.28em}
/* Open each category with one generous photo + longer editorial copy. */
.dish-grid > .dish:first-child{grid-column:1 / -1;display:grid;grid-template-columns:minmax(0,56%) minmax(0,44%);gap:0;border:1px solid #8065537a;border-radius:3px;background:linear-gradient(115deg,#20252b,#171e25)}
.dish-grid > .dish:first-child .dish-media{aspect-ratio:auto;min-height:365px;height:100%;border-radius:2px 0 0 2px}
.dish-grid > .dish:first-child .dish-copy{justify-content:center;min-height:365px;padding:50px 54px 86px 52px}
.dish-grid > .dish:first-child .dish-copy h3{font-size:clamp(40px,4.5vw,62px);line-height:.98;letter-spacing:-.052em;margin-bottom:17px}
.dish-grid > .dish:first-child .dish-copy p{font-size:15px;line-height:1.7;max-width:38ch;color:#ded4ca}
.dish-grid > .dish:first-child .dish-bottom{left:52px;bottom:34px;top:auto;right:auto}
.dish-grid > .dish:first-child .dish-bottom strong{font-size:36px}
.dish-grid > .dish:first-child .dish-bottom strong small{font-size:26px}
/* Native hash lightbox. No visible overlays on food imagery. */
.dish-media:target{height:100dvh;min-height:0;aspect-ratio:auto;z-index:9999;background:#0b1014f5;box-shadow:0 0 0 100vmax #0b1014f5;padding:24px;backdrop-filter:blur(15px);-webkit-backdrop-filter:blur(15px);animation:studioZoom .18s ease-out both}
.dish-media:target .photo-hit{height:100%;max-width:100%}
.dish-media:target img{max-height:min(90%,850px);border-radius:2px;object-fit:contain;filter:none}
.dish-media:target .zoom-close{top:calc(14px + env(safe-area-inset-top));right:18px;width:46px;height:46px;border:1px solid #d7b399aa;border-radius:50%;background:#1f252ad9;color:#f7e8db;font-size:29px}
@keyframes studioZoom{from{opacity:.5}to{opacity:1}}
/* Drinks / sets */
.cocktail-intro{color:#cfbeb0;font-family:var(--serif);font-size:23px;margin:-5px 0 25px}
.cocktail-meta{font-size:10px;letter-spacing:.13em;color:#d9aa8b;font-weight:700;margin:0 0 10px}
.set-heading{border-top:1px solid #745e54;padding:44px 0 10px;margin-top:13px}
.set-heading h3{font-size:43px;color:#f8e5d0}
.set-heading p{font-size:13px;color:#c4b9b0}
