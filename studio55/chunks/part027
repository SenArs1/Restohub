<script>(function(){'use strict';
var tabs=Array.from(document.querySelectorAll('.tab'));
var sections=Array.from(document.querySelectorAll('.menu-section'));
var search=document.getElementById('search');
var empty=document.getElementById('empty');
var status=document.getElementById('search-status');
var clear=document.getElementById('search-clear');
var nav=document.getElementById('navigation');
var current='all';
var aliases={
 'mango fiesta':'манго фиеста', 'passion wave':'пэшн вейв маракуйя',
 'nordic sun':'нордик сан', 'coco dream':'коко дрим', 'ruby':'руби',
 'moscow mule':'москоу мьюл московский мул',
 'feijoa gimlet':'фейхоа гимлет', 'porn star martini':'порнстар мартини',
 'raspberry rosso':'малина россо', 'rasberry rosso':'малина россо',
 'negroni':'негрони', 'long island':'лонг айленд',
 'aperol spritz':'апероль шприц', 'fiero tonic':'фиеро тоник',
 'lychee margarita':'личи маргарита', 'whiskey sour':'виски сауэр',
 'mojito':'мохито', 'pina colada':'пина колада',
 'russian long':'рашн лонг', 'surfer on acid':'серфер он эсид',
 'white russian':'белый русский', 'love is':'лав из',
 'raffaello':'рафаэлло', 'paradise kiss':'парадайз кисс'
};
function norm(str){return String(str||'').toLocaleLowerCase('ru-RU').replace(/ё/g,'е').replace(/[‐‑‒–—−]/g,'-').replace(/[^0-9a-zа-я]+/gi,' ').replace(/\s+/g,' ').trim();}
var cards=Array.from(document.querySelectorAll('article.dish')).map(function(el){
 var title=norm((el.querySelector('h3')||{}).textContent);
 var extra=aliases[title]||'';
 var section=el.closest('.menu-section');
 var group=section ? (section.querySelector('h2')||{}).textContent||'' : '';
 return {el:el,section:section,hays:norm((el.getAttribute('data-search')||'')+' '+group+' '+extra)};
});
function refresh(){
 var q=norm(search.value), words=q.split(' ').filter(Boolean),found=0;
 document.body.classList.toggle('is-searching',Boolean(q));
 sections.forEach(function(s){s.__visible=0;});
 cards.forEach(function(c){
  var belongs=current==='all'||c.section.dataset.category===current;
  var matched=!words.length||words.every(function(w){return c.hays.indexOf(w)!==-1;});
  var show=belongs && matched;
  c.el.hidden=!show;
  if(show){found++; c.section.__visible++;}
 });
 sections.forEach(function(s){s.hidden=!s.__visible;});
 empty.classList.toggle('visible',found===0);
 empty.textContent=q?'По запросу «'+search.value.trim()+'» ничего не найдено. Попробуйте другое название.':'В выбранном разделе пока нет позиций.';
 clear.hidden=!search.value;
 status.hidden=!q;
 if(q){status.textContent=found ? 'Найдено: '+found+' '+plural(found,['позиция','позиции','позиций']):'Ничего не найдено';}
 tabs.forEach(function(tab){var active=tab.dataset.group===current;tab.classList.toggle('active',active);if(active)tab.setAttribute('aria-current','true');else tab.removeAttribute('aria-current');});
}
function plural(n,forms){var x=n%100,y=n%10;return forms[(x>10&&x<20||y>4||y===0)?2:(y===1?0:1)];}
function atMenu(){var menu=document.getElementById('menu'); var offset=nav.getBoundingClientRect().height+8;
 var top=menu.getBoundingClientRect().top+window.scrollY-offset;
 window.scrollTo({top:Math.max(0,top),behavior:'instant'});
}
tabs.forEach(function(tab){tab.addEventListener('click',function(ev){ev.preventDefault();current=tab.dataset.group;search.value='';refresh();tab.scrollIntoView({block:'nearest',inline:'center',behavior:window.matchMedia('(prefers-reduced-motion: reduce)').matches?'instant':'smooth'});requestAnimationFrame(atMenu);});});
search.addEventListener('input',function(){current='all';refresh();});
search.addEventListener('search',function(){current='all';refresh();});
search.addEventListener('keydown',function(e){if(e.key==='Enter'){e.preventDefault();search.blur();requestAnimationFrame(function(){var target=document.querySelector('.menu-section:not([hidden])');if(target){var pos=target.getBoundingClientRect().top+window.scrollY-nav.getBoundingClientRect().height-6;window.scrollTo({top:Math.max(0,pos),behavior:'smooth'});}});}});
clear.addEventListener('click',function(){search.value='';current='all';refresh();search.focus();});
window.addEventListener('hashchange',function(){
 if(location.hash.startsWith('#photo-')){
  var id=decodeURIComponent(location.hash.slice(1));var frame=document.getElementById(id);
  if(frame){var img=frame.querySelector('img[data-full-src]');if(img && img.getAttribute('src')!==img.getAttribute('data-full-src'))img.src=img.getAttribute('data-full-src');}
  return;
 }
 if(location.hash.startsWith('#cat-')){
  var cat=location.hash.slice(5);if(sections.some(function(s){return s.dataset.category===cat;})){current=cat;search.value='';refresh();requestAnimationFrame(atMenu);}
 }
});
refresh();
})();</script></body></html>