# --- iikoCloud API ---
# API-ключ (apiLogin) из iikoWeb → Настройки → Облачное API
IIKO_API_LOGIN=
IIKO_API_URL=https://api-ru.iiko.services

# Организация: id приоритетнее, иначе ищем по названию
IIKO_ORGANIZATION_ID=
IIKO_ORGANIZATION_NAME=Madi Cake

# Внешнее меню (iikoWeb → Внешние заказы → Внешние меню): id приоритетнее, иначе по названию
IIKO_EXTERNAL_MENU_ID=
IIKO_EXTERNAL_MENU_NAME=Madi Cake
# Категория цен (необязательно; пусто — цены по умолчанию внешнего меню)
IIKO_PRICE_CATEGORY_ID=
# Версия формата ответа /api/2/menu/by_id (необязательно)
IIKO_MENU_VERSION=
IIKO_LANGUAGE=ru

# --- Restohub ---
PORT=8080
HOST=0.0.0.0
RESTAURANT_NAME=Madi Cake
CURRENCY=₽
# Как часто забирать меню из iiko (минуты)
SYNC_INTERVAL_MIN=5
# Скачивать фото блюд на сервер (нужно для офлайна)
CACHE_IMAGES=1
# Токен для POST /api/sync (ручная синхронизация)
ADMIN_TOKEN=change-me
# Через сколько секунд бездействия планшет возвращается на стартовый экран
IDLE_SECONDS=90
# 1 = демо-данные без iiko
DEMO=0
