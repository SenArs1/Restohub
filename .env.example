# --- iikoCloud API ---
# API-ключ из iikoWeb → Настройки → Облачное API
IIKO_API_LOGIN=
# Для ключей нового формата (/api/v2/access_token): приложение server-to-server на портале разработчика iiko
IIKO_CLIENT_SECRET=
IIKO_APP_ID=
IIKO_API_URL=https://api-ru.iiko.services

# Организация: id приоритетнее, иначе ищем по названию
IIKO_ORGANIZATION_ID=
IIKO_ORGANIZATION_NAME=Madi Cake

# Внешнее меню (iikoWeb → Внешние заказы → Внешние меню): id приоритетнее, иначе по названию
IIKO_EXTERNAL_MENU_ID=
IIKO_EXTERNAL_MENU_NAME=Madi Cake
# Группа терминалов для стоп-листа (необязательно; пусто — все группы организации)
IIKO_TERMINAL_GROUP_ID=
# Категория цен (необязательно; пусто — цены по умолчанию внешнего меню)
IIKO_PRICE_CATEGORY_ID=
# Версия формата ответа /api/2/menu/by_id (необязательно)
IIKO_MENU_VERSION=
IIKO_LANGUAGE=ru

# --- Restohub ---
PORT=8080
HOST=0.0.0.0
RESTAURANT_NAME=Madi Cake
CURRENCY=₽
# Папка данных: снимок iiko, база админки, фото (по умолчанию ./data)
DATA_DIR=
# Как часто забирать меню из iiko (минуты)
SYNC_INTERVAL_MIN=5
# Как часто проверять стоп-лист iiko (секунды)
STOPLIST_INTERVAL_SEC=60
# Скачивать фото блюд на сервер (нужно для офлайна)
CACHE_IMAGES=1
# --- HTTPS и безопасность ---
# Без HTTPS планшеты не работают офлайн после перезапуска браузера (service worker требует HTTPS).
# Вариант 1: встроенный HTTPS — пути к сертификату и ключу (PEM)
TLS_CERT_FILE=
TLS_KEY_FILE=
# Вариант 2: сервер за HTTPS-прокси (Caddy, nginx) — доверять X-Forwarded-Proto/-For/-Host
TRUST_PROXY=0
# 1 = cookie админки всегда с флагом Secure (по HTTPS он ставится автоматически)
COOKIE_SECURE=0
# Выход из админки после стольких часов бездействия
SESSION_IDLE_HOURS=24
# Через сколько минут без успешной синхронизации предупреждать об устаревших данных (0 — авто: 3 интервала, не меньше 15)
STALE_AFTER_MIN=0
# Токен для POST /api/sync (ручная синхронизация)
ADMIN_TOKEN=change-me
# Через сколько секунд бездействия планшет возвращается на стартовый экран
IDLE_SECONDS=90
# 1 = демо-данные без iiko
DEMO=0
