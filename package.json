{
  "name": "restohub",
  "version": "0.2.0",
  "description": "Restohub — электронное меню для планшетов с интеграцией iikoCloud (объект: Madi Cake)",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node server/index.js",
    "demo": "DEMO=1 node server/index.js",
    "iiko:check": "node scripts/iiko-check.js",
    "iiko:prices": "node scripts/price-check.js",
    "test": "node --test test/*.test.js",
    "admin:user": "node scripts/admin-user.js",
    "backup": "node scripts/backup.js",
    "media:cleanup": "node scripts/media-cleanup.js",
    "e2e:offline": "node test/e2e/offline.e2e.mjs",
    "e2e:admin": "node test/e2e/admin.e2e.mjs",
    "e2e": "node test/e2e/admin.e2e.mjs && node test/e2e/offline.e2e.mjs"
  },
  "dependencies": {
    "htm": "^3.1.1",
    "preact": "^10.29.8",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "playwright": "^1.56.1"
  }
}
